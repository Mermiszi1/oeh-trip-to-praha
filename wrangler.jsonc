{
  // ÖH Prague trip guide – Cloudflare Worker with static assets
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oeh-trip-to-praha",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // the worker runs first on every request, so the login protects every page
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash"
  }
  // ── Cloud sync + room publishing ─────────────────────────────────────────────
  // 1. Cloudflare → Storage & Databases → Workers KV → create "oeh-org" (if not done) and copy its ID.
  // 2. Delete the two slashes in front of the 3 lines below, paste the ID, and commit.
  //,"kv_namespaces": [
  //  { "binding": "ORG", "id": "PASTE_YOUR_KV_NAMESPACE_ID_HERE" }
  //]
}
